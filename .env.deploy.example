# Copie para .env.deploy no servidor (o .env.deploy fica fora do Git).
# Usado pelo docker-compose.yml (env_file).

# Google Gemini. Sem chave, o EditalCheck roda no modo offline (regras determinísticas).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
LLM_ATIVO=true
LLM_TIMEOUT_S=300
# Chamadas simultâneas ao LLM. Reduza se a cota do plano recusar requisições.
LLM_PARALELISMO=6

# bSDD (api.bsdd.buildingsmart.org). Envia só termos genéricos em inglês (ex.: "door").
BSDD_ATIVO=true
BSDD_TIMEOUT_S=5

# Limite de upload por arquivo (MB)
LIMITE_UPLOAD_MB=200
LOG_LEVEL=INFO

# Tratamento de dados (RNF-11). "efemero" (padrão): tudo só em memória, apagado ao
# encerrar o projeto ou após EDITALCHECK_TTL_MIN minutos sem uso. "persistente": grava
# projetos e relatórios em EDITALCHECK_DATA_DIR (só para desenvolvimento).
EDITALCHECK_MODO_DADOS=efemero
EDITALCHECK_TTL_MIN=120
# Data exibida na faixa do ambiente de demonstração (DD/MM/AAAA). Vazio esconde a data.
EDITALCHECK_DISPONIVEL_ATE=
# Log de auditoria sem conteúdo (JSON Lines). "off" desliga. Padrão: var/auditoria/auditoria.jsonl
# EDITALCHECK_AUDITORIA=

# Documentos de referência autorizados, usados como contexto do LLM (padrão:
# backend/resources/contexto). Veja o LEIA-ME.md da pasta.
# EDITALCHECK_CONTEXTO_DIR=

# Preço do modelo, em dólares por milhão de tokens, para o painel "Custo e tempo".
# Copie da página oficial de preços do provedor e informe a fonte e a data.
# Sem preço, o painel mostra só os tokens medidos.
LLM_PRECO_ENTRADA_USD_MTOK=
LLM_PRECO_SAIDA_USD_MTOK=
LLM_PRECO_FONTE=
