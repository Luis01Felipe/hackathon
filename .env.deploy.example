# Copie para .env.deploy no servidor (o .env.deploy fica fora do Git).
# Usado pelo docker-compose.yml (env_file).

# Google Gemini. Sem chave, o EditalCheck roda no modo offline (regras determinísticas).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
LLM_ATIVO=true
LLM_TIMEOUT_S=300
# Chamadas simultâneas ao LLM. Reduza se a cota do plano recusar requisições.
LLM_PARALELISMO=6

# bSDD (api.bsdd.buildingsmart.org). Envia só termos genéricos em inglês (ex.: "door").
BSDD_ATIVO=true
BSDD_TIMEOUT_S=5

# Limite de upload por arquivo (MB)
LIMITE_UPLOAD_MB=200
LOG_LEVEL=INFO
